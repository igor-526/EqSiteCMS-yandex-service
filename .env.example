# APPLICATION
ENVIRONMENT=development
DEBUG=true
APP_TITLE=Yandex Service

# SENTRY
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# POSTGRES
POSTGRES_USER=eqsitecmsyandex
POSTGRES_PASSWORD=eqsitecmsyandex
POSTGRES_HOST=db-yandex
POSTGRES_PORT=5432
POSTGRES_DB=yandex_service

# YANDEX ENCRYPTION (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
YANDEX_ENCRYPTION_KEY=<generate-fernet-key-32-bytes-base64>

# Yandex application for authorization
YANDEX_CLIENT_ID=<YANDEX_CLIENT_ID>
YANDEX_CLIENT_SECRET=<YANDEX_CLIENT_SECRET>