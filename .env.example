ENVIRONMENT=development
DEBUG=true
APP_TITLE=FastAPI Template
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app

ENCRYPTION_SERVICE_KEY=<ENCRYPTION_SERVICE_KEY>

YANDEX_APP_CLIENT_ID=<YANDEX_APP_CLIENT_ID>
YANDEX_APP_CLIENT_SECRET=<YANDEX_APP_CLIENT_SECRET>
YANDEX_APP_REDIRECT_URI=<YANDEX_APP_REDIRECT_URI>
# Maintenance producer runs in HTTP lifespan; completed consumer is a separate slice.
# Internal development address only; production requires isolated NATS/ACL.
NATS_SERVERS=nats://localhost:4222
NATS_SETUP_MAX_ATTEMPTS=10
NATS_SETUP_BACKOFF_SECONDS=2
NATS_CONNECT_TIMEOUT_SECONDS=5
NATS_PUBLISH_TIMEOUT_SECONDS=5
NATS_RELAY_POLL_SECONDS=1
NATS_RELAY_CLAIM_SECONDS=30
NATS_ERROR_REPORT_AFTER_ATTEMPTS=5
